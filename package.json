{
  "name": "agent-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Plugins for multiple coding agents: Claude Code, DSH, Pi.",
  "packageManager": "pnpm@10.6.3",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "node --test \"scripts/test/*.test.ts\" && pnpm -r --if-present test",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "validate": "node scripts/validate.ts",
    "docs:check": "node plugins/repl-server/server/scripts/version.ts && node plugins/repl-server/server/scripts/doc-facts.ts && node plugins/repl-server/server/scripts/doc-admin.ts",
    "docs:version": "node plugins/repl-server/server/scripts/version.ts --write",
    "matrix": "node scripts/matrix.ts",
    "matrix:check": "node scripts/matrix.ts --check"
  },
  "devDependencies": {
    "@types/node": "22.19.21",
    "typescript": "7.0.2"
  }
}
