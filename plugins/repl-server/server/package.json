{
  "name": "@zhangliang0115/repl-server",
  "version": "0.3.1",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "description": "MCP server that runs JavaScript against Claude Code tools and third-party MCP servers.",
  "main": "./dist/index.js",
  "bin": {
    "repl-server": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "release": "node scripts/release.mjs",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "docs:check": "node scripts/version.ts --check && node scripts/doc-facts.ts && node scripts/doc-admin.ts",
    "docs:write": "node scripts/version.ts --write"
  },
  "devDependencies": {
    "@zhangliang0115/repl-server-core": "workspace:*",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=22.19"
  }
}
